<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:EzPocket.Controls" x:Class="EzPocket.PocketHealthPage" BackgroundColor="#FFFFFF" Title="Pocket health">
    <ScrollView><VerticalStackLayout Padding="28,20,28,28" Spacing="14">
        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6"><controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" /><Label Grid.Column="1" Text="EZ-POCKET" TextDecorations="Underline" FontSize="11" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Label.GestureRecognizers></Label><Label Grid.Column="2" Text="/ HEALTH" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" /></Grid>
        <VerticalStackLayout Spacing="4"><Label Text="Pocket health" FontSize="26" FontAttributes="Bold" TextColor="#151515" /><Label Text="Read-only checks before you make a change. Nothing on the target is modified." FontSize="13" TextColor="#60605C" /></VerticalStackLayout>
        <Border BackgroundColor="#151515" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="14,10"><VerticalStackLayout Spacing="3"><Label Text="READ-ONLY INSPECTION" FontSize="11" FontAttributes="Bold" TextColor="White"/><Label Text="Checks folders, installed core metadata, and storage headroom. Repairs are never applied from this screen." FontSize="13" TextColor="#D2D2CC"/></VerticalStackLayout></Border>
        <Border BackgroundColor="White" Stroke="#151515" StrokeThickness="1" StrokeShape="RoundRectangle 2" Padding="16"><VerticalStackLayout Spacing="7"><Label Text="TARGET" FontSize="11" FontAttributes="Bold" TextColor="#60605C"/><Label x:Name="TargetName" FontSize="18" FontAttributes="Bold" TextColor="#151515"/><Label x:Name="Summary" FontSize="13" TextColor="#60605C"/><controls:EzButton x:Name="InitializeButton" Text="INITIALIZE TARGET" IsVisible="False" Clicked="OnInitializeClicked" ButtonBackgroundColor="#151515" CornerRadius="2" HorizontalOptions="Start" /></VerticalStackLayout></Border>
        <Label Text="CHECK RESULTS" FontSize="11" FontAttributes="Bold" TextColor="#151515"/><VerticalStackLayout x:Name="FindingList" Spacing="0" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
