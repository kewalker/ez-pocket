<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             xmlns:models="clr-namespace:EzPocket.Models"
             x:Class="EzPocket.AssetRemovalReviewPage"
             BackgroundColor="#FFFFFF"
             Title="Review asset removal">
    <ScrollView>
        <VerticalStackLayout Padding="28,20,28,28" Spacing="14">
            <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="5">
                <controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" SemanticProperties.Description="Back to asset set" />
                <Label Grid.Column="1" Text="ASSET LIBRARY" TextDecorations="Underline" FontSize="11" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Label.GestureRecognizers></Label>
                <Label Grid.Column="2" Text="/ REMOVE" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout Spacing="3"><Label Text="Review asset removal" FontSize="26" FontAttributes="Bold" TextColor="#151515" /><Label x:Name="Summary" Text="Preparing review…" FontSize="13" TextColor="#60605C" /></VerticalStackLayout>
            <Border BackgroundColor="White" Stroke="#151515" StrokeThickness="1" StrokeShape="RoundRectangle 2" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="FILES TO REMOVE" FontSize="11" FontAttributes="Bold" TextColor="#151515" />
                    <CollectionView x:Name="FileList" SelectionMode="None" HeightRequest="250"><CollectionView.ItemTemplate><DataTemplate x:DataType="models:ManagedAsset"><Grid ColumnDefinitions="*,Auto" Padding="0,7"><VerticalStackLayout Spacing="1"><Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#151515" /><Label Text="{Binding RelativePath}" FontSize="11" TextColor="#60605C" /></VerticalStackLayout><Label Grid.Column="1" Text="{Binding Format}" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="#F4F4F0" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="14,11"><Label Text="Every listed file is copied to an ez-pocket backup before it is removed. No cores, saves, or other asset directories are affected." FontSize="12" TextColor="#151515" /></Border>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><controls:EzButton Text="CANCEL" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" CornerRadius="2" MinimumHeight="34" ButtonPadding="12,5" Clicked="OnBackClicked" /><controls:EzButton x:Name="RemoveButton" Grid.Column="1" Text="REMOVE FILES" CornerRadius="2" MinimumHeight="34" ButtonPadding="12,5" HorizontalOptions="End" Clicked="OnRemoveClicked" /></Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
