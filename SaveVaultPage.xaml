<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             x:Class="EzPocket.SaveVaultPage"
             BackgroundColor="#FFFFFF"
             Title="Save Vault">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28,20,28,28" Spacing="14">
                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                    <controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" SemanticProperties.Description="Back to dashboard" />
                    <Label Grid.Column="1" Text="EZ-POCKET" TextDecorations="Underline" TextColor="#151515" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Label.GestureRecognizers></Label>
                    <Label Grid.Column="2" Text="/ SAVE VAULT" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Save Vault" FontSize="26" FontAttributes="Bold" TextColor="#151515" />
                    <Label Text="Create local snapshots of Saves and Memories before maintenance or whenever you want a restore point." FontSize="13" TextColor="#60605C" />
                </VerticalStackLayout>

                <Border BackgroundColor="#151515" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="14,10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="SNAPSHOT + REVIEWED RESTORE" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Snapshots only read the selected Pocket. A restore writes only the files you select, after a comparison, confirmation, and local safety snapshot." FontSize="13" TextColor="#D2D2CC" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#151515" StrokeThickness="1" StrokeShape="RoundRectangle 2" Padding="16">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="TARGET" FontSize="11" FontAttributes="Bold" TextColor="#60605C" />
                        <Label x:Name="TargetName" Text="No Pocket selected" FontSize="18" FontAttributes="Bold" TextColor="#151515" />
                        <Label x:Name="TargetDetail" FontSize="13" TextColor="#60605C" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="SNAPSHOT CONTENTS" FontSize="11" FontAttributes="Bold" TextColor="#151515" />
                    <Border BackgroundColor="#F4F4F0" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <Label Text="SAVES" FontSize="14" FontAttributes="Bold" TextColor="#151515" />
                            <Label x:Name="SavesSummary" Grid.Column="1" FontSize="12" TextColor="#60605C" VerticalOptions="Center" />
                            <Label Grid.Row="1" Text="Saved game data stored on this target." FontSize="12" TextColor="#60605C" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="#F4F4F0" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <Label Text="MEMORIES" FontSize="14" FontAttributes="Bold" TextColor="#151515" />
                            <Label x:Name="MemoriesSummary" Grid.Column="1" FontSize="12" TextColor="#60605C" VerticalOptions="Center" />
                            <Label Grid.Row="1" Text="Pocket save states and their related data." FontSize="12" TextColor="#60605C" />
                        </Grid>
                    </Border>
                    <Label x:Name="SnapshotSummary" FontSize="12" TextColor="#60605C" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <controls:EzButton x:Name="CreateSnapshotButton" Text="CREATE SNAPSHOT" Clicked="OnCreateSnapshotClicked" CornerRadius="2" />
                    <ActivityIndicator x:Name="CreatingIndicator" IsVisible="False" IsRunning="False" Color="#151515" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label x:Name="Status" FontSize="13" TextColor="#60605C" />

                <VerticalStackLayout Spacing="6">
                    <Label Text="RECENT SNAPSHOTS" FontSize="11" FontAttributes="Bold" TextColor="#151515" />
                    <VerticalStackLayout x:Name="SnapshotList" Spacing="0" />
                    <Label x:Name="EmptySnapshots" Text="No snapshots for this target yet." FontSize="13" TextColor="#60605C" />
                    <Label Text="Snapshots remain local. Open a restore preview to compare its save files with the target before writing." FontSize="11" TextColor="#60605C" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="RestorePanel" IsVisible="False" Spacing="8">
                    <Label Text="RESTORE PREVIEW" FontSize="11" FontAttributes="Bold" TextColor="#151515" />
                    <Border BackgroundColor="#F4F4F0" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="14,10">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="RestoreSnapshotName" FontSize="14" FontAttributes="Bold" TextColor="#151515" />
                            <Label x:Name="RestoreSummary" FontSize="12" TextColor="#60605C" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout x:Name="RestoreList" Spacing="0" />
                    <Label Text="TARGET-ONLY FILES ARE KEPT" FontSize="11" FontAttributes="Bold" TextColor="#60605C" />
                    <HorizontalStackLayout Spacing="10">
                        <controls:EzButton x:Name="SelectRestoreChangesButton" Text="SELECT ALL" FontSize="11" MinimumHeight="32" ButtonPadding="10,4" ButtonBackgroundColor="#E5E5DF" ButtonTextColor="#151515" Clicked="OnSelectRestoreChangesClicked" CornerRadius="2" />
                        <controls:EzButton x:Name="ClearRestoreSelectionButton" Text="CLEAR" FontSize="11" MinimumHeight="32" ButtonPadding="10,4" ButtonBackgroundColor="#E5E5DF" ButtonTextColor="#151515" Clicked="OnClearRestoreSelectionClicked" CornerRadius="2" />
                        <controls:EzButton x:Name="RestoreSelectedButton" Text="RESTORE SELECTED" FontSize="11" MinimumHeight="32" ButtonPadding="10,4" Clicked="OnRestoreSelectedClicked" CornerRadius="2" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controls:EzToast x:Name="SuccessToast" ZIndex="10" WidthRequest="440" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,16,0,0" />
    </Grid>
</ContentPage>
