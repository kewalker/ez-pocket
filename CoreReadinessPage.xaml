<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:EzPocket.Controls" x:Class="EzPocket.CoreReadinessPage" BackgroundColor="#FFFFFF" Title="Core readiness">
    <ScrollView><VerticalStackLayout Padding="28,20,28,28" Spacing="14">
        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6"><controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" SemanticProperties.Description="Back" /><Label Grid.Column="1" Text="EZ-POCKET" TextDecorations="Underline" FontSize="11" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Label.GestureRecognizers></Label><Label Grid.Column="2" Text="/ CORE READINESS" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" /></Grid>
        <VerticalStackLayout Spacing="4"><Label Text="Core readiness" FontSize="26" FontAttributes="Bold" TextColor="#151515" /><Label Text="Checks that each installed core has the fixed files it loads by itself, such as a BIOS. Nothing on the target is modified." FontSize="13" TextColor="#60605C" /></VerticalStackLayout>
        <Border BackgroundColor="#151515" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="14,10"><VerticalStackLayout Spacing="3"><Label Text="READ-ONLY INSPECTION" FontSize="11" FontAttributes="Bold" TextColor="White"/><Label Text="Locations and sizes come from each core's own data.json. ez-pocket never downloads or supplies BIOS or game files; it tells you which file a core expects and where." FontSize="13" TextColor="#D2D2CC"/></VerticalStackLayout></Border>
        <Border BackgroundColor="White" Stroke="#151515" StrokeThickness="1" StrokeShape="RoundRectangle 2" Padding="16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="5"><Label Text="TARGET" FontSize="11" FontAttributes="Bold" TextColor="#60605C"/><Label x:Name="TargetName" FontSize="18" FontAttributes="Bold" TextColor="#151515"/><Label x:Name="Summary" FontSize="13" TextColor="#60605C"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center"><ActivityIndicator x:Name="CheckingIndicator" IsVisible="False" IsRunning="False" Color="#151515" VerticalOptions="Center" /><controls:EzButton x:Name="CheckButton" Text="CHECK AGAIN" Clicked="OnCheckClicked" CornerRadius="2" /></HorizontalStackLayout></Grid></Border>
        <Grid ColumnDefinitions="*,Auto"><Label x:Name="ListHeading" Text="NEEDS ATTENTION" FontSize="11" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center"/><controls:EzButton x:Name="ShowReadyButton" Grid.Column="1" Text="SHOW READY CORES" IsVisible="False" Clicked="OnShowReadyClicked" FontSize="10" ButtonPadding="8,3" MinimumHeight="28" CornerRadius="2" ButtonBackgroundColor="#E5E5DF" ButtonTextColor="#151515" /></Grid>
        <VerticalStackLayout x:Name="CoreList" Spacing="0" />
        <Label Text="Arcade games defined by instance JSON files are not checked yet. ez-pocket is independent and not affiliated with, endorsed by, or sponsored by Analogue." FontSize="11" TextColor="#60605C" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
