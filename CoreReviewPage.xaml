<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EzPocket.Models"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             x:Class="EzPocket.CoreReviewPage"
             BackgroundColor="#F5F7FB"
             Title="Review changes">
    <Grid Padding="24,16,24,20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="8" ButtonBackgroundColor="#E8F0FF" ButtonTextColor="#1E3A8A" SemanticProperties.Description="Back to Core Manager" />
            <Label Grid.Column="1" Text="ez-pocket" TextDecorations="Underline" TextColor="#2563EB" FontSize="13" VerticalOptions="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeClicked" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="2" Text="/" FontSize="13" TextColor="#AAB3C4" VerticalOptions="Center" />
            <Label Grid.Column="3" Text="Manage cores" TextDecorations="Underline" TextColor="#2563EB" FontSize="13" VerticalOptions="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnManageCoresClicked" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="4" Text="/" FontSize="13" TextColor="#AAB3C4" VerticalOptions="Center" />
            <Label Grid.Column="5" Text="Review changes" FontSize="13" TextColor="#63708A" VerticalOptions="Center" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <Label Text="Review changes" FontSize="26" FontAttributes="Bold" TextColor="#14213D" />
            <Label Text="Selected cores will be installed or updated. Nothing else is changed." FontSize="14" TextColor="#63708A" />
        </VerticalStackLayout>
        <Border Grid.Row="2" BackgroundColor="#EEF6F1" Stroke="#CDE8D6" StrokeShape="RoundRectangle 12" Padding="14,10">
            <Label Text="No changes have been made. Review the package changes before you apply them." FontSize="13" TextColor="#176B49" />
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <controls:EzButton x:Name="PrepareButton" Text="Prepare changes" Clicked="OnPrepareClicked" ButtonPadding="14,8" />
            <controls:EzButton x:Name="SyncButton" Grid.Column="1" Text="Apply changes" IsVisible="False" Clicked="OnSyncClicked" ButtonPadding="14,8" />
            <ActivityIndicator x:Name="PreparingIndicator" Grid.Column="2" IsVisible="False" IsRunning="False" Color="#2563EB" HorizontalOptions="Start" VerticalOptions="Center" />
        </Grid>
        <Grid Grid.Row="4" RowDefinitions="Auto,110,Auto,*" RowSpacing="10">
            <Label x:Name="SyncStatus" Text="Prepare selected packages to inspect the files that will be added or replaced." TextColor="#63708A" />
            <CollectionView Grid.Row="1" x:Name="SelectedCoreList" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No cores selected." TextColor="#63708A" VerticalOptions="Center" HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CoreComparison">
                    <Border BackgroundColor="White" Stroke="#E2E7F0" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Text="{Binding FriendlyName}" FontSize="16" FontAttributes="Bold" TextColor="#14213D" />
                            <Label Grid.Row="1" Text="{Binding Identifier}" FontSize="12" TextColor="#63708A" />
                            <Label Grid.Column="1" Grid.RowSpan="2" Text="{Binding StatusLabel}" FontSize="13" FontAttributes="Bold" TextColor="#19734E" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border BackgroundColor="#E8F7EE" Stroke="#B8E0C5" StrokeShape="RoundRectangle 10" Padding="10,7">
                    <Label x:Name="AddSummary" Text="0 cores · 0 files to add or replace" TextColor="#19734E" FontSize="12" FontAttributes="Bold" />
                </Border>
                <Border Grid.Column="1" BackgroundColor="#FDEBEC" Stroke="#F2C1C5" StrokeShape="RoundRectangle 10" Padding="10,7">
                    <Label x:Name="RemoveSummary" Text="0 cores · 0 files to remove" TextColor="#B42318" FontSize="12" FontAttributes="Bold" />
                </Border>
            </Grid>
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <Label Text="Add or replace" TextColor="#19734E" FontAttributes="Bold" />
                    <CollectionView Grid.Row="1" x:Name="ChangeList" SelectionMode="None" IsVisible="False">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoreSyncFileChange">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Action}" TextColor="#19734E" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding RelativePath}" TextColor="#14213D" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" Text="{Binding SizeLabel}" TextColor="#63708A" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
                    <Label Text="Remove" TextColor="#B42318" FontAttributes="Bold" />
                    <CollectionView Grid.Row="1" x:Name="RemovalList" SelectionMode="None" IsVisible="False">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoreSyncRemoval">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding FriendlyName}" TextColor="#14213D" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding Summary}" TextColor="#B42318" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
