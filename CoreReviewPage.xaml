<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EzPocket.Models"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             x:Class="EzPocket.CoreReviewPage"
             BackgroundColor="#FFFFFF"
             Title="Sync changes">
    <Grid Padding="28,20,28,24" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <controls:EzButton Text="←" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" SemanticProperties.Description="Back to previous page" />
            <Label Grid.Column="1" Text="EZ-POCKET" TextDecorations="Underline" TextColor="#151515" FontSize="11" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeClicked" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="2" Text="/" FontSize="13" TextColor="#90908B" VerticalOptions="Center" />
            <Label Grid.Column="3" Text="CORE INVENTORY" TextDecorations="Underline" TextColor="#151515" FontSize="11" FontAttributes="Bold" VerticalOptions="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnManageCoresClicked" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="4" Text="/" FontSize="13" TextColor="#90908B" VerticalOptions="Center" />
            <Label Grid.Column="5" Text="REVIEW CHANGES" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="5">
            <Label Text="Review changes" FontSize="26" FontAttributes="Bold" TextColor="#151515" />
            <Label Text="Inspect the plan before anything is written to your target." FontSize="13" TextColor="#60605C" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border BackgroundColor="#151515" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="14,10">
                <Label Text="ONLY THE ADDITIONS, REPLACEMENTS, AND REMOVALS BELOW WILL CHANGE. EVERYTHING ELSE STAYS AS IT IS." FontSize="11" FontAttributes="Bold" TextColor="White" />
            </Border>
            <Border x:Name="FeaturedSetSummary" IsVisible="False" BackgroundColor="#F4F4F0" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="12,8">
                <Label x:Name="FeaturedSetSummaryText" TextColor="#151515" FontSize="13" />
            </Border>
        </VerticalStackLayout>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <controls:EzButton x:Name="PrepareButton" Text="PREPARE AGAIN" IsVisible="False" Clicked="OnPrepareClicked" ButtonPadding="14,8" CornerRadius="2" />
            <controls:EzButton x:Name="SyncButton" Grid.Column="1" Text="APPLY CHANGES" IsVisible="False" Clicked="OnSyncClicked" ButtonPadding="14,8" CornerRadius="2" />
            <ActivityIndicator x:Name="PreparingIndicator" Grid.Column="2" IsVisible="False" IsRunning="False" Color="#151515" HorizontalOptions="Start" VerticalOptions="Center" />
        </Grid>
        <Grid Grid.Row="4" RowDefinitions="Auto,*" RowSpacing="10">
            <Label x:Name="SyncStatus" Text="Calculating planned changes…" TextColor="#60605C" />
            <Grid x:Name="ChangeDetails" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border BackgroundColor="#F4F4F0" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="10,7">
                    <Label x:Name="AddSummary" Text="0 cores · 0 files to add or replace" TextColor="#151515" FontSize="12" FontAttributes="Bold" />
                </Border>
                <Border Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="10,7">
                    <Label x:Name="RemoveSummary" Text="0 cores · 0 files to remove" TextColor="#151515" FontSize="12" FontAttributes="Bold" />
                </Border>
            </Grid>
            <Border Grid.Row="1" BackgroundColor="White" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="12,10">
                <Grid RowDefinitions="Auto,*" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="SELECTED CORES" TextColor="#151515" FontSize="11" FontAttributes="Bold" />
                        <Label x:Name="SelectedCoreSummary" Grid.Column="1" TextColor="#60605C" FontSize="12" />
                    </Grid>
                    <CollectionView Grid.Row="1" x:Name="SelectedCoreList" SelectionMode="None" HeightRequest="154">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoreComparison">
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                    <Label Text="{Binding FriendlyName}" FontSize="13" FontAttributes="Bold" TextColor="#151515" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding InstalledVersion}" FontSize="12" TextColor="#60605C" />
                                    <Label Grid.Column="2" Text="{Binding AvailableVersion}" FontSize="12" TextColor="#137A49" />
                                    <Label Grid.Row="1" Text="{Binding Identifier}" FontSize="11" TextColor="#60605C" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusLabel}" FontSize="11" TextColor="#60605C" HorizontalOptions="End" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
            <Border Grid.Row="2" x:Name="OverrideSummary" IsVisible="False" BackgroundColor="#F4F4F0" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="10,7">
                <Label x:Name="OverrideSummaryText" TextColor="#151515" FontSize="12" FontAttributes="Bold" />
            </Border>
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <Label Text="ADD OR REPLACE" TextColor="#151515" FontSize="11" FontAttributes="Bold" />
                    <CollectionView Grid.Row="1" x:Name="ChangeList" SelectionMode="None" IsVisible="False">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoreSyncFileChange">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Action}" TextColor="#137A49" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding RelativePath}" TextColor="#151515" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="2" Text="{Binding SizeLabel}" TextColor="#60605C" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
                    <Label Text="REMOVE" TextColor="#151515" FontSize="11" FontAttributes="Bold" />
                    <CollectionView Grid.Row="1" x:Name="RemovalList" SelectionMode="None" IsVisible="False">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CoreSyncRemoval">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding FriendlyName}" TextColor="#151515" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding Summary}" TextColor="#60605C" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
