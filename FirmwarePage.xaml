<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             x:Class="EzPocket.FirmwarePage"
             BackgroundColor="#FFFFFF"
             Title="Update Pocket firmware">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="28,20,28,28" Spacing="14">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <controls:EzButton Text="←" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" SemanticProperties.Description="Back to dashboard" />
                <Label Grid.Column="1" Text="EZ-POCKET" TextDecorations="Underline" TextColor="#151515" FontSize="11" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="2" Text="/" FontSize="13" TextColor="#90908B" VerticalOptions="Center" />
                <Label Grid.Column="3" Text="FIRMWARE" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout Spacing="4">
                <Label Text="PocketOS firmware" FontSize="26" FontAttributes="Bold" TextColor="#151515" />
                <Label Text="Official firmware is verified and staged separately from core updates." FontSize="13" TextColor="#60605C" />
            </VerticalStackLayout>
            <Border BackgroundColor="#151515" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="14,10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="CORES, ASSETS, AND SAVES ARE NOT CHANGED." FontSize="11" FontAttributes="Bold" TextColor="White" />
                    <Label Text="This only stages a verified official firmware file at the root of the selected target. Safely eject storage before updating your Pocket." FontSize="13" TextColor="#D2D2CC" />
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="White" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="TARGET" FontSize="11" FontAttributes="Bold" TextColor="#60605C" />
                    <Label x:Name="TargetName" Text="No Pocket selected" FontSize="18" FontAttributes="Bold" TextColor="#151515" />
                    <Label x:Name="TargetPath" TextColor="#60605C" FontSize="13" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="PreviewCard" IsVisible="False" BackgroundColor="#F4F4F0" Stroke="#151515" StrokeShape="RoundRectangle 2" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                    <Label x:Name="ReleaseTitle" FontSize="18" FontAttributes="Bold" TextColor="#151515" />
                    <Label x:Name="ReleaseDetail" Grid.Row="1" FontSize="13" TextColor="#60605C" />
                    <Label x:Name="ChecksumDetail" Grid.Row="2" FontSize="12" TextColor="#137A49" />
                    <Label x:Name="ReplacementDetail" Grid.Row="3" FontSize="12" TextColor="#60605C" />
                </Grid>
            </Border>
            <Label x:Name="FirmwareStatus" Text="Check the official firmware source before staging anything on your Pocket." TextColor="#60605C" />
            <HorizontalStackLayout Spacing="10">
                <controls:EzButton x:Name="PrepareButton" Text="CHECK FIRMWARE" Clicked="OnPrepareClicked" CornerRadius="2" />
                <controls:EzButton x:Name="ApplyButton" Text="STAGE FIRMWARE" IsVisible="False" Clicked="OnApplyClicked" ButtonBackgroundColor="#151515" CornerRadius="2" />
                <ActivityIndicator x:Name="PreparingIndicator" IsVisible="False" IsRunning="False" Color="#151515" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    <controls:EzToast x:Name="SuccessToast" ZIndex="10" WidthRequest="440" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,16,0,0" />
    </Grid>
</ContentPage>
