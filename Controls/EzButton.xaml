<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             x:Name="Root"
             x:DataType="controls:EzButton"
             x:Class="EzPocket.Controls.EzButton">
    <Button x:Name="NativeButton"
            Text="{Binding Text, Source={x:Reference Root}}"
            FontAttributes="{Binding FontAttributes, Source={x:Reference Root}}"
            CornerRadius="{Binding CornerRadius, Source={x:Reference Root}}"
            Padding="{Binding ButtonPadding, Source={x:Reference Root}}"
            Clicked="OnNativeClicked"
            Pressed="OnNativePressed"
            Released="OnNativeReleased"
            Focused="OnNativeFocused"
            Unfocused="OnNativeUnfocused">
        <Button.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
        </Button.GestureRecognizers>
    </Button>
</ContentView>
