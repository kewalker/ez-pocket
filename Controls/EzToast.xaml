<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             x:Class="EzPocket.Controls.EzToast"
             x:Name="Root"
             IsVisible="False"
             SemanticProperties.Description="Success message">
    <Border BackgroundColor="#FFFFFF" Stroke="#151515" StrokeThickness="1" StrokeShape="RoundRectangle 2" Padding="0">
        <Grid RowDefinitions="Auto,3">
            <Grid ColumnDefinitions="Auto,*,44" ColumnSpacing="10" Padding="14,10">
                <Label Text="✓" FontSize="16" TextColor="#19734E" VerticalOptions="Center" />
                <Label x:Name="MessageLabel" Grid.Column="1" TextColor="#151515" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                <controls:EzButton Grid.Column="2" Text="&#x00D7;" FontSize="20" MinimumHeight="36" WidthRequest="44" ButtonPadding="0" CornerRadius="0" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnDismissClicked" VerticalOptions="Center" HorizontalOptions="Fill" SemanticProperties.Description="Dismiss success message" />
            </Grid>
            <ProgressBar x:Name="Timer" Grid.Row="1" Progress="1" ProgressColor="#151515" BackgroundColor="#D0D0CA" HeightRequest="3" HorizontalOptions="Fill" VerticalOptions="End" SemanticProperties.Description="Time remaining before this message closes" />
        </Grid>
    </Border>
</ContentView>
