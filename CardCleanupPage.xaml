<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:EzPocket.Controls" x:Class="EzPocket.CardCleanupPage" BackgroundColor="#FFFFFF" Title="Card cleanup">
    <ScrollView><VerticalStackLayout Padding="28,20,28,28" Spacing="14">
        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6"><controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" SemanticProperties.Description="Back" /><Label Grid.Column="1" Text="EZ-POCKET" TextDecorations="Underline" FontSize="11" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackClicked" /></Label.GestureRecognizers></Label><Label Grid.Column="2" Text="/ CARD CLEANUP" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" /></Grid>
        <VerticalStackLayout Spacing="4"><Label Text="Card cleanup" FontSize="26" FontAttributes="Bold" TextColor="#151515" /><Label Text="Find hidden macOS files that show up as clutter in Pocket menus. Review what was found; nothing is removed until you choose REMOVE SELECTED." FontSize="13" TextColor="#60605C" /></VerticalStackLayout>
        <Border BackgroundColor="White" Stroke="#151515" StrokeThickness="1" StrokeShape="RoundRectangle 2" Padding="16"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><VerticalStackLayout Spacing="5"><Label Text="TARGET" FontSize="11" FontAttributes="Bold" TextColor="#60605C"/><Label x:Name="TargetName" FontSize="18" FontAttributes="Bold" TextColor="#151515"/><Label x:Name="Summary" FontSize="13" TextColor="#60605C"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center"><ActivityIndicator x:Name="ScanningIndicator" IsVisible="False" IsRunning="False" Color="#151515" VerticalOptions="Center" /><controls:EzButton x:Name="ScanButton" Text="SCAN AGAIN" Clicked="OnScanClicked" CornerRadius="2" ButtonBackgroundColor="#E5E5DF" ButtonTextColor="#151515" /></HorizontalStackLayout></Grid></Border>
        <Label Text="FOUND ON THIS CARD" FontSize="11" FontAttributes="Bold" TextColor="#151515"/>
        <VerticalStackLayout x:Name="GroupList" Spacing="0" />
        <Border BackgroundColor="#F4F4F0" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="14,11"><Label Text="Only the files listed above are removed, and each is checked again first: it must still be the same size and still be a macOS metadata file. These files are not backed up; they hold no game, save, or core data. Games, saves, cores, and asset folders are never touched." FontSize="12" TextColor="#151515" /></Border>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><Label x:Name="ResultLabel" FontSize="13" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center" IsVisible="False" /><controls:EzButton x:Name="EjectButton" Grid.Column="1" Text="EJECT CARD" IsVisible="False" Clicked="OnEjectClicked" CornerRadius="2" ButtonBackgroundColor="#E5E5DF" ButtonTextColor="#151515" /><controls:EzButton x:Name="RemoveButton" Grid.Column="2" Text="REMOVE SELECTED" IsEnabled="False" Clicked="OnRemoveClicked" CornerRadius="2" /></Grid>
        <VerticalStackLayout x:Name="LeftoverSection" Spacing="6" IsVisible="False" Margin="0,10,0,0">
            <Label Text="LEFTOVER CORE FOLDERS · REPORT ONLY" FontSize="11" FontAttributes="Bold" TextColor="#151515"/>
            <Label Text="These core-specific asset folders belong to cores that are no longer installed. They may contain your games or BIOS files, so ez-pocket does not remove them. Reinstall the core to use them again, or delete them yourself if you no longer need them." FontSize="12" TextColor="#60605C" />
            <VerticalStackLayout x:Name="LeftoverList" Spacing="0" />
        </VerticalStackLayout>
    </VerticalStackLayout></ScrollView>
</ContentPage>
