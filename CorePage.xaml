<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:EzPocket.Models"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             x:Class="EzPocket.CorePage"
             BackgroundColor="#F5F7FB"
             Title="Core Manager">
    <Grid Padding="28,24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
            <controls:EzButton Text="&#x2190;" FontSize="22" Clicked="OnBackClicked" ButtonPadding="14,5" SemanticProperties.Description="Back" />
            <Label Grid.Column="1" Text="ez-pocket" TextDecorations="Underline" TextColor="#2563EB" FontSize="14" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                    <PointerGestureRecognizer PointerEntered="OnBreadcrumbPointerEntered" PointerExited="OnBreadcrumbPointerExited" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="2" Text="/" FontSize="14" TextColor="#AAB3C4" VerticalOptions="Center" />
            <Label Grid.Column="3" Text="Manage cores" FontSize="14" TextColor="#63708A" VerticalOptions="Center" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="Core Manager" FontSize="30" FontAttributes="Bold" TextColor="#14213D" />
            <Label x:Name="Subtitle" Text="Scan a Pocket to compare installed and available cores." FontSize="14" TextColor="#63708A" />
        </VerticalStackLayout>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Label x:Name="Summary" Text="-" FontSize="16" FontAttributes="Bold" TextColor="#14213D" VerticalOptions="Center" />
            <Label x:Name="InventoryState" Grid.Column="1" Text="" FontSize="13" TextColor="#63708A" VerticalOptions="Center" />
            <controls:EzButton x:Name="RefreshButton" Grid.Column="2" Text="Refresh" Clicked="OnRefreshClicked" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,220" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="Search" FontSize="12" FontAttributes="Bold" TextColor="#52627A" />
                <Border BackgroundColor="White" Stroke="#B8C4D6" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="4,0">
                    <SearchBar x:Name="Search" Placeholder="Search cores" PlaceholderColor="#718096" TextColor="#14213D" BackgroundColor="Transparent" HeightRequest="46" TextChanged="OnFilterChanged" />
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="4">
                <Label Text="Status" FontSize="12" FontAttributes="Bold" TextColor="#52627A" />
                <Border BackgroundColor="White" Stroke="#B8C4D6" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="1" Text="⌄" FontSize="20" TextColor="#52627A" VerticalOptions="Center" InputTransparent="True" />
                        <Picker Grid.ColumnSpan="2" x:Name="StatusFilter" TextColor="#14213D" BackgroundColor="Transparent" FontSize="14" HeightRequest="46" HorizontalOptions="Fill" SelectedIndex="0" SelectedIndexChanged="OnFilterChanged" SemanticProperties.Description="Status filter dropdown">
                            <Picker.Items>
                                <x:String>All cores</x:String><x:String>Updates</x:String><x:String>Installed</x:String><x:String>Available</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" IsVisible="False" x:Name="SelectionBar" BackgroundColor="#E8F0FF" Padding="14,10" ColumnSpacing="14">
            <Label x:Name="SelectionSummary" TextColor="#1E3A8A" VerticalOptions="Center" />
            <controls:EzButton x:Name="ReviewButton" Grid.Column="1" Text="Review changes" Clicked="OnReviewClicked" />
        </Grid>
        <Grid Grid.Row="5">
            <CollectionView x:Name="CoreList" SelectionMode="None">
            <CollectionView.EmptyView><Label Text="No cores found yet." TextColor="#63708A" HorizontalOptions="Center" VerticalOptions="Center" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CoreComparison">
                    <Border BackgroundColor="White" Stroke="#E2E7F0" StrokeShape="RoundRectangle 14" Padding="16" Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCoreRowTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2" ColumnSpacing="8">
                            <CheckBox Grid.RowSpan="2" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalOptions="Center" Color="#2563EB" CheckedChanged="OnCoreSelectionChanged" />
                            <Label Grid.Column="1" Text="{Binding FriendlyName}" FontSize="16" FontAttributes="Bold" TextColor="#14213D" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Identifier}" FontSize="12" TextColor="#63708A" />
                            <VerticalStackLayout Grid.Column="2" Grid.RowSpan="2" HorizontalOptions="End" Spacing="3">
                                <Label Text="{Binding StatusLabel}" FontSize="13" FontAttributes="Bold" TextColor="#19734E" HorizontalTextAlignment="End" />
                                <Label Text="{Binding VersionLabel}" FontSize="12" TextColor="#63708A" HorizontalTextAlignment="End" />
                                <controls:EzButton Text="Details" FontSize="12" ButtonPadding="10,3" Clicked="OnDetailsClicked" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout x:Name="LoadingState" IsVisible="False" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="#2563EB" />
                <Label Text="Loading core inventory…" TextColor="#63708A" />
            </VerticalStackLayout>
            <VerticalStackLayout x:Name="OfflineState" IsVisible="False" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="Live inventory is unavailable." FontSize="16" FontAttributes="Bold" TextColor="#14213D" HorizontalTextAlignment="Center" />
                <Label Text="Showing installed cores. Check your connection and try again." TextColor="#63708A" HorizontalTextAlignment="Center" />
                <controls:EzButton Text="Retry" Clicked="OnRefreshClicked" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
