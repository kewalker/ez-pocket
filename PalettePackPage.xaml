<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:EzPocket.Controls" xmlns:models="clr-namespace:EzPocket.Models" x:Class="EzPocket.PalettePackPage" Title="Browse palette pack" BackgroundColor="#FFFFFF">
    <Grid Padding="28,20,28,28" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="14">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="5"><controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" /><Label Grid.Column="1" Text="ASSET LIBRARY" FontSize="11" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center" /><Label Grid.Column="2" Text="/ PALETTE PACK" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" /></Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="3"><Label Text="Browse palette pack" FontSize="26" FontAttributes="Bold" TextColor="#151515" /><Label x:Name="Summary" FontSize="13" TextColor="#60605C" /></VerticalStackLayout>
        <Label Grid.Row="2" Text="Both Pocket APGB (.pal) and GB core (.gbp) palettes are available. Nothing is selected by default." FontSize="12" TextColor="#60605C" />
        <SearchBar Grid.Row="3" Placeholder="FILTER BY PALETTE OR FOLDER" TextChanged="OnFilterChanged" BackgroundColor="#F4F4F0" TextColor="#151515" PlaceholderColor="#60605C" />
        <CollectionView Grid.Row="4" x:Name="PaletteList" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged"><CollectionView.ItemTemplate><DataTemplate x:DataType="models:AssetFileChange"><Grid Padding="0,7"><VerticalStackLayout Spacing="1"><Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#151515" /><Label Text="{Binding RelativePath}" FontSize="11" TextColor="#60605C" LineBreakMode="TailTruncation" /></VerticalStackLayout></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView>
        <Grid Grid.Row="5" ColumnDefinitions="Auto,*" ColumnSpacing="10"><controls:EzButton Text="CANCEL" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" CornerRadius="2" MinimumHeight="34" ButtonPadding="12,5" Clicked="OnBackClicked" /><controls:EzButton x:Name="ReviewButton" Grid.Column="1" Text="REVIEW 0 PALETTES" CornerRadius="2" MinimumHeight="34" ButtonPadding="12,5" HorizontalOptions="End" Clicked="OnReviewClicked" /></Grid>
    </Grid>
</ContentPage>
