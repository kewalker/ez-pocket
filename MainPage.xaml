<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EzPocket.MainPage"
             BackgroundColor="#F5F7FB"
             Title="Dashboard">
    <ScrollView>
        <VerticalStackLayout Padding="28,24,28,40" Spacing="22">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label Text="ez-pocket" FontSize="32" FontAttributes="Bold" TextColor="#14213D" />
                    <Label Text="Your Analogue Pocket, up to date." FontSize="15" TextColor="#63708A" />
                </VerticalStackLayout>
                <Border Grid.Column="1" BackgroundColor="#E4F7EF" StrokeThickness="0" Padding="12,8" StrokeShape="RoundRectangle 16">
                    <HorizontalStackLayout Spacing="6">
                        <BoxView Color="#2EB67D" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                        <Label Text="Ready" FontSize="13" FontAttributes="Bold" TextColor="#19734E" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
            <Border BackgroundColor="#14213D" StrokeThickness="0" Padding="22" StrokeShape="RoundRectangle 22">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="16">
                    <Label Text="Pocket status" TextColor="#AEBBD4" FontSize="13" />
                    <Label Grid.Row="1" Text="No Pocket connected" TextColor="White" FontSize="24" FontAttributes="Bold" />
                    <Label Grid.Row="2" Text="Connect an SD card or USB Pocket to begin." TextColor="#C8D2E4" FontSize="14" />
                    <Button Grid.Column="1" Grid.RowSpan="3" Text="Scan" Clicked="OnScanClicked" BackgroundColor="#FCA311" TextColor="#14213D" FontAttributes="Bold" CornerRadius="14" Padding="22,0" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Label Text="Update overview" FontSize="20" FontAttributes="Bold" TextColor="#14213D" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border BackgroundColor="White" Stroke="#E2E7F0" StrokeShape="RoundRectangle 16" Padding="16"><VerticalStackLayout Spacing="6"><Label Text="Cores" TextColor="#63708A" FontSize="13" /><Label Text="—" FontSize="26" FontAttributes="Bold" TextColor="#14213D" /><Label Text="Not scanned" TextColor="#63708A" FontSize="12" /></VerticalStackLayout></Border>
                <Border Grid.Column="1" BackgroundColor="White" Stroke="#E2E7F0" StrokeShape="RoundRectangle 16" Padding="16"><VerticalStackLayout Spacing="6"><Label Text="Updates" TextColor="#63708A" FontSize="13" /><Label Text="—" FontSize="26" FontAttributes="Bold" TextColor="#14213D" /><Label Text="Ready to check" TextColor="#63708A" FontSize="12" /></VerticalStackLayout></Border>
                <Border Grid.Column="2" BackgroundColor="White" Stroke="#E2E7F0" StrokeShape="RoundRectangle 16" Padding="16"><VerticalStackLayout Spacing="6"><Label Text="Last sync" TextColor="#63708A" FontSize="13" /><Label Text="Never" FontSize="20" FontAttributes="Bold" TextColor="#14213D" /><Label Text="No backup yet" TextColor="#63708A" FontSize="12" /></VerticalStackLayout></Border>
            </Grid>
            <Border BackgroundColor="#FFF7E6" Stroke="#F8D99A" StrokeShape="RoundRectangle 16" Padding="18"><VerticalStackLayout Spacing="6"><Label Text="Designed for safe updates" FontSize="16" FontAttributes="Bold" TextColor="#7B4D00" /><Label Text="ez-pocket will scan first, show exactly what changes, and keep a backup before writing to your Pocket." FontSize="14" TextColor="#8A620F" /></VerticalStackLayout></Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
