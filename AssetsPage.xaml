<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:EzPocket.Controls"
             xmlns:models="clr-namespace:EzPocket.Models"
             x:Class="EzPocket.AssetsPage"
             BackgroundColor="#FFFFFF"
             Title="Assets">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28,20,28,28" Spacing="14">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <controls:EzButton Text="&#x2190;" FontSize="16" MinimumHeight="24" Clicked="OnBackClicked" ButtonPadding="10,1" CornerRadius="2" ButtonBackgroundColor="#151515" ButtonTextColor="White" SemanticProperties.Description="Back" />
                    <Label Grid.Column="1" Text="EZ-POCKET" TextDecorations="Underline" TextColor="#151515" FontSize="11" FontAttributes="Bold" VerticalOptions="Center"><Label.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeClicked" /></Label.GestureRecognizers></Label>
                    <Label Grid.Column="2" Text="/" FontSize="13" TextColor="#90908B" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="ASSET LIBRARY" FontSize="11" FontAttributes="Bold" TextColor="#60605C" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Spacing="3">
                    <Label Text="Asset library" FontSize="26" FontAttributes="Bold" TextColor="#151515" />
                    <Label x:Name="TargetSummary" Text="Select a target to inspect optional core assets." FontSize="13" TextColor="#60605C" />
                </VerticalStackLayout>
                <Border BackgroundColor="White" Stroke="#151515" StrokeThickness="1" StrokeShape="RoundRectangle 2" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="GAME BOY PALETTES" FontSize="11" FontAttributes="Bold" TextColor="#151515" />
                                <Label x:Name="PaletteSummary" Text="Custom palette files shared by the GB asset system." FontSize="18" FontAttributes="Bold" TextColor="#151515" />
                                <Label Text="Import .pal (Pocket APGB) or .gbp files. Choosing a palette still happens on Pocket; no core setting is changed here." FontSize="12" TextColor="#60605C" />
                                <HorizontalStackLayout Spacing="8" Margin="0,5,0,0">
                                    <controls:EzButton x:Name="DownloadPackButton" Text="DOWNLOAD PACK" FontSize="11" MinimumHeight="34" ButtonPadding="11,5" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" CornerRadius="2" Clicked="OnDownloadPackClicked" SemanticProperties.Description="Download the community Game Boy palette collection and prepare it for review" />
                                    <controls:EzButton Text="CREATE PALETTE" FontSize="11" MinimumHeight="34" ButtonPadding="11,5" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" CornerRadius="2" Clicked="OnPaletteEditorClicked" SemanticProperties.Description="Open a Game Boy palette editor in a browser" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <controls:EzButton x:Name="ImportButton" Grid.Column="1" Text="IMPORT PALETTES" Clicked="OnImportClicked" FontSize="11" MinimumHeight="34" ButtonPadding="11,5" CornerRadius="2" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" VerticalOptions="Center" />
                        </Grid>
                        <CollectionView x:Name="PaletteList" SelectionMode="None" HeightRequest="250">
                            <CollectionView.EmptyView><Label Text="No custom palettes found on this target." TextColor="#60605C" VerticalOptions="Center" HorizontalOptions="Center" /></CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:ManagedAsset">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,8" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="1"><Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#151515" /><Label Text="{Binding RelativePath}" FontSize="11" TextColor="#60605C" LineBreakMode="TailTruncation" /></VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="End"><Label Text="{Binding Format}" FontSize="11" FontAttributes="Bold" TextColor="#151515" HorizontalTextAlignment="End" /><Label Text="{Binding Compatibility}" FontSize="11" TextColor="#60605C" HorizontalTextAlignment="End" /></VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="White" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="3"><Label Text="POCKET LIBRARY ART" FontSize="11" FontAttributes="Bold" TextColor="#151515" /><Label Text="Box art for handheld and adapter systems" FontSize="16" FontAttributes="Bold" TextColor="#151515" /><Label Text="Select one system, then review every file before it is copied." FontSize="12" TextColor="#60605C" /></VerticalStackLayout>
                            <controls:EzButton x:Name="LibraryArtButton" Grid.Column="1" Text="CHOOSE SYSTEM" FontSize="11" MinimumHeight="34" ButtonPadding="11,5" CornerRadius="2" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnLibraryArtClicked" VerticalOptions="Center" />
                        </Grid>
                        <Grid x:Name="LibraryArtChoices" IsVisible="False" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <controls:EzButton Text="GAME BOY + GBC" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnGameBoyArtClicked" />
                            <controls:EzButton Grid.Column="1" Text="GAME BOY ADVANCE" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnGameBoyAdvanceArtClicked" />
                            <controls:EzButton Grid.Row="1" Text="GAME GEAR" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnGameGearArtClicked" />
                            <controls:EzButton Grid.Row="1" Grid.Column="1" Text="NEO GEO POCKET" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnNeoGeoArtClicked" />
                            <controls:EzButton Grid.Row="2" Text="ATARI LYNX" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnLynxArtClicked" />
                            <controls:EzButton Grid.Row="2" Grid.Column="1" Text="PC ENGINE" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnPcEngineArtClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="White" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="ASSET INVENTORY" FontSize="11" FontAttributes="Bold" TextColor="#151515" />
                            <Label Text="Installed optional asset sets" FontSize="16" FontAttributes="Bold" TextColor="#151515" />
                            <Label Text="REFRESHES WHEN OPENED" FontSize="10" FontAttributes="Bold" TextColor="#60605C" />
                        </VerticalStackLayout>
                        <CollectionView x:Name="AssetSetList" SelectionMode="None" HeightRequest="245">
                            <CollectionView.EmptyView><Label Text="Select a target to inspect its asset inventory." TextColor="#60605C" VerticalOptions="Center" HorizontalOptions="Center" /></CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:AssetSetInventory">
                                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,7" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#151515" />
                                            <Label Text="{Binding Kind}" FontSize="11" TextColor="#60605C" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="#151515" VerticalOptions="Center" HorizontalTextAlignment="End" />
                                        <controls:EzButton Grid.Column="2" Text="MANAGE" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" CornerRadius="2" Clicked="OnManageAssetSetClicked" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="White" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><VerticalStackLayout Spacing="3"><Label Text="OPENFPGA PLATFORM ART" FontSize="11" FontAttributes="Bold" TextColor="#151515" /><Label Text="System artwork for the openFPGA launcher" FontSize="16" FontAttributes="Bold" TextColor="#151515" /><Label Text="This copies images only; it never changes platform metadata or core JSON." FontSize="12" TextColor="#60605C" /></VerticalStackLayout><controls:EzButton x:Name="PlatformArtButton" Grid.Column="1" Text="CHOOSE PRESENTATION" FontSize="11" MinimumHeight="34" ButtonPadding="11,5" CornerRadius="2" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnPlatformArtClicked" VerticalOptions="Center" /></Grid>
                        <Grid x:Name="PlatformArtChoices" IsVisible="False" ColumnDefinitions="*,*,*" ColumnSpacing="8"><controls:EzButton Text="HOME US" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnHomeUsArtClicked" /><controls:EzButton Grid.Column="1" Text="HOME JAPAN" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnHomeJapanArtClicked" /><controls:EzButton Grid.Column="2" Text="ARCADE" FontSize="10" MinimumHeight="30" ButtonPadding="9,4" ButtonBackgroundColor="#F4F4F0" ButtonTextColor="#151515" Clicked="OnArcadeArtClicked" /></Grid>
                    </VerticalStackLayout>
                </Border>
                <Border BackgroundColor="#F4F4F0" Stroke="#C9C9C2" StrokeShape="RoundRectangle 2" Padding="14,11">
                    <VerticalStackLayout Spacing="3"><Label Text="ASSET SETS STAY OPTIONAL" FontSize="11" FontAttributes="Bold" TextColor="#151515" /><Label Text="Palettes, library art, and platform art are tracked here instead of crowding core inventory. Every download remains reviewable before files are copied to the target." FontSize="12" TextColor="#60605C" /></VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ActivityIndicator x:Name="DownloadActivity" IsVisible="False" IsRunning="False" Color="#52627A" HeightRequest="16" WidthRequest="16" />
                    <Label x:Name="Status" Grid.Column="1" FontSize="12" TextColor="#52627A" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
        <controls:EzToast x:Name="SuccessToast" ZIndex="10" WidthRequest="440" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,16,0,0" />
    </Grid>
</ContentPage>
